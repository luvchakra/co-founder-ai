# Copy to .env.local and fill in with the dev Supabase project's real values.
# Never commit .env.local — it is gitignored.

# Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by the Supabase CLI for migrations (supabase db push / link).
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Required for lib/ai/ (product profile generation and everything built on it).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Shared secret checked against the x-webhook-secret header on
# /api/webhooks/email-inbound (Epic 9). Generate a random value; configure the same value
# on your email provider's inbound-parse webhook.
EMAIL_INBOUND_WEBHOOK_SECRET=your-random-webhook-secret

# BYOK (Epic 3, docs/byok-ai-requirements.md): encrypts provider API keys
# (lib/crypto/api-key.ts) before storing them in ai_provider_credentials.
# Must decode from base64 to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value makes every already-stored key undecryptable -- treat it
# like a database credential, not an app config value.
API_KEY_ENCRYPTION_SECRET=your-base64-encoded-32-byte-secret
