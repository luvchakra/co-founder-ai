# Copy to .env.local and fill in with the dev Supabase project's real values.
# Never commit .env.local — it is gitignored.

# Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by the Supabase CLI for migrations (supabase db push / link).
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# AI provider key(s) — added when Epic 3 (Product Intelligence) wires lib/ai/.
# ANTHROPIC_API_KEY=
